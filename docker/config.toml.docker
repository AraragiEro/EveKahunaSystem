# ============================================
# KahunaBot Docker 配置文件（仅后端 + MCP）
# ============================================
# 复制此文件为 config.toml 并修改 EVE API 配置

[EDITION]
Edition = "community"

[APP]
PIC_RENDER_PROXY = ""
PROXY = ""
PORT = 0
# 应用签名密钥（JWT / 会话签名）：生产必须改成随机长密钥（建议 ≥32 位）
# 可用环境变量 KAHUNA_SECRET_KEY 覆盖（优先于本项）；留空或仍是模板占位符时启动会中断
SECRET_KEY = "change-me-to-a-random-secret-key"
# API 文档配置
ENABLE_API_DOCS = false
API_DOCS_PATH = "/api/docs"
API_OPENAPI_PATH = "/api/openapi.json"

[GOOGLE]
CREDENTIALS = "credentials/google-service-account.json"
MARKET_MONITOR_SPREADSHEET_ID = ""

[ADMIN]
# 默认管理员账号创建（安全审计 #11：模板不再内置 kahuna/kahuna 这类默认口令）
# 部署时必须显式填写 admin_user / admin_passwd 后把 create_admin 置为 true；
# 口令要求：≥12 位，且不得使用 kahuna/kahuna、admin/admin、password、123456 之类默认值；
# 留空或弱口令时，启动会拒绝创建管理员账号（仅记录日志，不中断服务启动）。
create_admin = false
admin_user = ""
admin_passwd = ""

[POSTGREDB]
Host = ""
Port = 5432
Database = ""
User = ""
Password = ""

[REDIS]
Host = ""
Port = 6379
# 生产建议设置强口令；也可用环境变量 REDIS_PASSWORD 覆盖本项（留空 = 无认证）
Password = ""

[NEO4J]
Host = ""
Port = 7687
Username = ""
Password = ""

[SQLITEDB]
CONFIG_DB = "data/kahuna_config.db"
CACHE_DB = "data/kahuna_cache.db"
SDEDB = ""
CN_SDEDB = ""

[SDEDB]
Host = ""
Port = 5432
Database = ""
User = ""
Password = ""

[SDE_BUILDER]
Latest_Version_URL = "https://developers.eveonline.com/static-data/tranquility/latest.jsonl"
Latest_Download_URL = "https://developers.eveonline.com/static-data/eve-online-static-data-latest-jsonl.zip"
Download_Path = "download_resource/sde"
Extract_Path = "tmp/sde"
Current_Build_Number = 0
Parse_Whitelist = [
    "types",
    "blueprints",
    "MetaGroups",
    "metaGroups",
    "groups",
    "categories",
    "marketGroups",
    "mapSolarSystems",
    "mapRegions",
    "typeMaterials",
]
Auto_Update = false
Update_Interval = 24

[EVE]
CLIENT_ID = ""
SECRET_KEY = ""
CALLBACK_LOCAL_HOST = "localhost:9527/"

[ESI]
publicData = false
"esi-calendar.respond_calendar_events.v1" = false
"esi-calendar.read_calendar_events.v1" = false
"esi-location.read_location.v1" = false
"esi-location.read_ship_type.v1" = false
"esi-mail.organize_mail.v1" = false
"esi-mail.read_mail.v1" = false
"esi-mail.send_mail.v1" = false
"esi-skills.read_skills.v1" = true
"esi-skills.read_skillqueue.v1" = false
"esi-wallet.read_character_wallet.v1" = true
"esi-wallet.read_corporation_wallet.v1" = false
"esi-search.search_structures.v1" = true
"esi-clones.read_clones.v1" = false
"esi-characters.read_contacts.v1" = false
"esi-universe.read_structures.v1" = true
"esi-killmails.read_killmails.v1" = false
"esi-corporations.read_corporation_membership.v1" = true
"esi-assets.read_assets.v1" = true
"esi-planets.manage_planets.v1" = false
"esi-fleets.read_fleet.v1" = false
"esi-fleets.write_fleet.v1" = false
"esi-ui.open_window.v1" = false
"esi-ui.write_waypoint.v1" = false
"esi-characters.write_contacts.v1" = false
"esi-fittings.read_fittings.v1" = false
"esi-fittings.write_fittings.v1" = false
"esi-markets.structure_markets.v1" = true
"esi-corporations.read_structures.v1" = false
"esi-characters.read_loyalty.v1" = false
"esi-characters.read_chat_channels.v1" = false
"esi-characters.read_medals.v1" = false
"esi-characters.read_standings.v1" = false
"esi-characters.read_agents_research.v1" = false
"esi-industry.read_character_jobs.v1" = true
"esi-markets.read_character_orders.v1" = true
"esi-characters.read_blueprints.v1" = true
"esi-characters.read_corporation_roles.v1" = true
"esi-location.read_online.v1" = false
"esi-contracts.read_character_contracts.v1" = true
"esi-clones.read_implants.v1" = false
"esi-characters.read_fatigue.v1" = false
"esi-killmails.read_corporation_killmails.v1" = false
"esi-corporations.track_members.v1" = false
"esi-wallet.read_corporation_wallets.v1" = false
"esi-characters.read_notifications.v1" = false
"esi-corporations.read_divisions.v1" = false
"esi-corporations.read_contacts.v1" = false
"esi-assets.read_corporation_assets.v1" = true
"esi-corporations.read_titles.v1" = false
"esi-corporations.read_blueprints.v1" = true
"esi-contracts.read_corporation_contracts.v1" = true
"esi-corporations.read_standings.v1" = false
"esi-corporations.read_starbases.v1" = false
"esi-industry.read_corporation_jobs.v1" = true
"esi-markets.read_corporation_orders.v1" = false
"esi-corporations.read_container_logs.v1" = false
"esi-industry.read_character_mining.v1" = false
"esi-industry.read_corporation_mining.v1" = false
"esi-planets.read_customs_offices.v1" = false
"esi-corporations.read_facilities.v1" = false
"esi-corporations.read_medals.v1" = false
"esi-characters.read_titles.v1" = false
"esi-alliances.read_contacts.v1" = false
"esi-characters.read_fw_stats.v1" = false
"esi-corporations.read_fw_stats.v1" = false


# ============================================
# MCP 中间件安全配置
# ============================================
[MCP]
# MCP 内部 API 认证密钥（必须与 Docker 环境变量 QUART_API_KEY 一致）
# 生产环境必须填写一个随机长字符串
API_KEY = ""

# ============================================
# 服务间认证（供 MCP 中间件 / QQ 机器人等无法登录的服务调用）
# ============================================
[SERVICE]
# 共享服务密钥：调用方在请求头 X-Internal-API-Key 中携带
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 留空 = 拒绝所有服务间请求（fail-closed，不会再退回无校验状态）
API_KEY = ""
# 灰度开关：enforce = 强制执行（默认）；warn = 仅记录告警不拦截（切换期使用）
MODE = "enforce"
